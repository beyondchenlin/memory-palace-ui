/* Mood pets — Duolingo-warm, clickable on desktop */

.mascot-btn {
  position: relative;
}
.mascot-pet {
  position: absolute;
  right: -6px;
  bottom: -4px;
  font-size: 0.95rem;
  line-height: 1;
  filter: drop-shadow(0 2px 3px rgba(0,0,0,0.18));
  animation: petBob 2.8s ease-in-out infinite;
  pointer-events: none;
}
.mascot-btn-mini .mascot-pet {
  font-size: 0.78rem;
  right: -4px;
  bottom: -3px;
}

@keyframes petBob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-3px); }
}

.finish-swatch {
  position: relative;
}
.finish-swatch .swatch-pet {
  position: absolute;
  top: 4px;
  right: 6px;
  font-size: 0.85rem;
  line-height: 1;
  pointer-events: none;
  opacity: 0.95;
}

/* Desktop / Pad wandering pet — MUST be a hit target */
.stage-pet {
  position: fixed;
  z-index: 40;
  width: 64px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  cursor: pointer;
  pointer-events: auto !important;
  transition:
    left 2.8s cubic-bezier(0.22, 1, 0.36, 1),
    top 2.8s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.35s ease;
  left: 82%;
  top: 55%;
  -webkit-tap-highlight-color: transparent;
}
.stage-pet:focus-visible {
  outline: 3px solid var(--green, #58cc02);
  outline-offset: 4px;
  border-radius: 50%;
}
.stage-pet:hover .stage-pet-emoji {
  transform: scale(1.12);
}
.stage-pet.is-hidden,
.stage-pet[hidden] {
  display: none !important;
  pointer-events: none !important;
}
.stage-pet.is-flip .stage-pet-emoji {
  transform: scaleX(-1);
}
.stage-pet.is-react .stage-pet-emoji {
  animation: petReact 0.55s cubic-bezier(0.22, 1, 0.36, 1);
}
@keyframes petReact {
  0% { transform: scale(1) translateY(0); }
  35% { transform: scale(1.35) translateY(-14px); }
  100% { transform: scale(1) translateY(0); }
}
.stage-pet-emoji {
  font-size: 2.25rem;
  line-height: 1;
  filter: drop-shadow(0 6px 10px rgba(0,0,0,0.22));
  animation: petIdle 3.2s ease-in-out infinite;
  transition: transform 0.35s ease;
  pointer-events: none;
}
.stage-pet-bubble {
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.55), transparent 70%);
  opacity: 0.7;
  animation: petGlow 3.2s ease-in-out infinite;
  pointer-events: none;
}
@keyframes petIdle {
  0%, 100% { transform: translateY(0) rotate(-4deg); }
  50% { transform: translateY(-8px) rotate(4deg); }
}
@keyframes petGlow {
  0%, 100% { opacity: 0.45; transform: scale(0.92); }
  50% { opacity: 0.85; transform: scale(1.05); }
}

body.is-real-phone .stage-pet {
  display: none !important;
  pointer-events: none !important;
}

@media (prefers-reduced-motion: reduce) {
  .mascot-pet,
  .stage-pet-emoji,
  .stage-pet-bubble {
    animation: none !important;
  }
  .stage-pet {
    transition: none;
  }
}
